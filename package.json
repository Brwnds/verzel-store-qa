{
  "name": "verzel-store-qa",
  "version": "1.0.0",
  "description": "Teste técnico QA Júnior Verzel: validação da entrega VZS-142 (cupom de desconto e frete grátis) da Verzel Store",
  "author": "Brenda Beatriz Maciel da Silva",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "evidencias": "node scripts/coletar-evidencias.mjs",
    "relatorio:pages": "node -e \"const fs=require('fs');fs.rmSync('docs/relatorio-playwright',{recursive:true,force:true});fs.cpSync('playwright-report','docs/relatorio-playwright',{recursive:true})\"",
    "test:postman": "node --no-deprecation node_modules/newman/bin/newman.js run docs/postman/verzel-store.postman_collection.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "newman": "^6.2.1"
  }
}
